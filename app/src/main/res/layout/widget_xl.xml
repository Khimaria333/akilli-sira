<?xml version="1.0" encoding="utf-8"?>
<!-- Ahenk widget'ı (Notifier.updateWidgets doldurur) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/w_glow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_glow" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/logo_mark" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
        android:text="Ahenk" android:textColor="#F4F4F8" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_mood" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:layout_weight="1" android:ellipsize="end" android:singleLine="true"
        android:text="" android:textColor="#A3A3B5" android:textSize="11.5sp" />
    <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:singleLine="true" android:text="" android:textColor="#FF4D6D"
        android:textSize="11sp" android:textStyle="bold" />
</LinearLayout><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/w_cover" android:layout_width="68dp" android:layout_height="68dp"
        android:scaleType="centerCrop" android:src="@drawable/logo_mark" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:ellipsize="end" android:singleLine="true" android:text="Bir şarkı aç" android:textColor="#F4F4F8"
    android:textSize="15.5sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:ellipsize="end" android:singleLine="true" android:text="" android:textColor="#A3A3B5"
    android:textSize="12.5sp" android:layout_marginTop="1dp"/>
        <TextView android:id="@+id/w_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:ellipsize="end" android:singleLine="true" android:text="" android:textColor="#6E6E82"
    android:textSize="12sp" android:layout_marginTop="3dp"/>
    </LinearLayout>
    <ImageView android:id="@+id/w_like" android:layout_width="40dp" android:layout_height="40dp"
    android:background="@drawable/widget_icon_btn" android:padding="9dp" android:scaleType="fitCenter"
    android:src="@drawable/ic_w_heart" android:layout_marginStart="4dp"/>
</LinearLayout><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<ProgressBar android:id="@+id/w_progress" style="@android:style/Widget.ProgressBar.Horizontal"
    android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="8dp"
    android:max="1000" android:progress="0" android:progressDrawable="@drawable/widget_progress" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <ImageView android:id="@+id/w_dislike" android:layout_width="40dp" android:layout_height="40dp"
    android:background="@drawable/widget_icon_btn" android:padding="10dp" android:scaleType="fitCenter"
    android:src="@drawable/ic_w_dislike" />
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <ImageView android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp"
    android:background="@drawable/widget_icon_btn" android:padding="8dp" android:scaleType="fitCenter"
    android:src="@drawable/ic_w_prev" />
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <ImageView android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp"
        android:background="@drawable/widget_play_btn" android:padding="11dp" android:scaleType="fitCenter"
        android:src="@drawable/ic_w_play" />
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <ImageView android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp"
    android:background="@drawable/widget_icon_btn" android:padding="8dp" android:scaleType="fitCenter"
    android:src="@drawable/ic_w_next" />
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <TextView android:id="@+id/w_eta" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center"
        android:text="" android:textColor="#6E6E82" android:textSize="10.5sp" android:textStyle="bold" />
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
</LinearLayout><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:id="@+id/w_next_box" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" android:background="@drawable/widget_card" android:gravity="center_vertical"
    android:orientation="horizontal" android:padding="6dp">
    <ImageView android:id="@+id/w_next_cover" android:layout_width="40dp" android:layout_height="40dp"
        android:scaleType="centerCrop" android:src="@drawable/logo_mark" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_next_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:letterSpacing="0.1" android:text="SIRADAKİ" android:textColor="#FF4D6D" android:textSize="9.5sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_next_title" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:ellipsize="end" android:singleLine="true" android:text="—" android:textColor="#F4F4F8"
    android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_next_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:ellipsize="end" android:singleLine="true" android:text="" android:textColor="#A3A3B5"
    android:textSize="11.5sp" />
    </LinearLayout>
    <ImageView android:id="@+id/w_next_dislike" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginEnd="4dp" android:background="@drawable/widget_icon_btn" android:padding="8dp"
        android:scaleType="fitCenter" android:src="@drawable/ic_w_dislike" />
    <ImageView android:id="@+id/w_next_skip" android:layout_width="34dp" android:layout_height="34dp"
        android:background="@drawable/widget_play_btn" android:padding="9dp" android:scaleType="fitCenter"
        android:src="@drawable/ic_w_next" />
</LinearLayout><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:id="@+id/w_up_box" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.1"
        android:text="SONRA" android:textColor="#6E6E82" android:textSize="9.5sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_up1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:ellipsize="end" android:singleLine="true" android:text=""
        android:textColor="#A3A3B5" android:textSize="12sp" /><TextView android:id="@+id/w_up2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:ellipsize="end" android:singleLine="true" android:text=""
        android:textColor="#A3A3B5" android:textSize="12sp" /><TextView android:id="@+id/w_up3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:ellipsize="end" android:singleLine="true" android:text=""
        android:textColor="#A3A3B5" android:textSize="12sp" />
</LinearLayout><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" android:orientation="horizontal">
    <TextView android:id="@+id/w_chip_sakin" android:layout_width="0dp" android:layout_height="28dp"
        android:layout_weight="1" android:background="@drawable/widget_chip" android:gravity="center"
        android:singleLine="true" android:text="😌 Sakin" android:textColor="#F4F4F8" android:textSize="11.5sp" /><TextView android:id="@+id/w_chip_enerjik" android:layout_width="0dp" android:layout_height="28dp"
        android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/widget_chip" android:gravity="center"
        android:singleLine="true" android:text="⚡ Enerjik" android:textColor="#F4F4F8" android:textSize="11.5sp" /><TextView android:id="@+id/w_chip_gunun" android:layout_width="0dp" android:layout_height="28dp"
        android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/widget_chip" android:gravity="center"
        android:singleLine="true" android:text="☀️ Günün" android:textColor="#F4F4F8" android:textSize="11.5sp" /><TextView android:id="@+id/w_chip_fav" android:layout_width="0dp" android:layout_height="28dp"
        android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/widget_chip" android:gravity="center"
        android:singleLine="true" android:text="❤️ Favori" android:textColor="#F4F4F8" android:textSize="11.5sp" />
</LinearLayout>
    </LinearLayout>
</FrameLayout>
