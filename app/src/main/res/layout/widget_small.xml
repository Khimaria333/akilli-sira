<?xml version="1.0" encoding="utf-8"?>
<!-- Ahenk widget'ı (Notifier.updateWidgets doldurur) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/w_glow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_glow" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical"
        android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/w_cover" android:layout_width="48dp" android:layout_height="48dp"
        android:scaleType="centerCrop" android:src="@drawable/logo_mark" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:ellipsize="end" android:singleLine="true" android:text="Bir şarkı aç" android:textColor="#F4F4F8"
    android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_next_line" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:ellipsize="end" android:singleLine="true" android:text="" android:textColor="#A3A3B5"
    android:textSize="11.5sp" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <ImageView android:id="@+id/w_play" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginStart="6dp" android:background="@drawable/widget_play_btn" android:padding="10dp"
        android:scaleType="fitCenter" android:src="@drawable/ic_w_play" />
    <ImageView android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp"
    android:background="@drawable/widget_icon_btn" android:padding="9dp" android:scaleType="fitCenter"
    android:src="@drawable/ic_w_next" android:layout_marginStart="2dp"/>
</LinearLayout>
    </LinearLayout>
</FrameLayout>
